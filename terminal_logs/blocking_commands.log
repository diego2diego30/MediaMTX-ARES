     9	EMAIL="admin@ares-werx.com"
    10	
    11	echo "=================================================================="
    12	echo "   🚀 Starting ARES-WERX One-Click Full Stack Deployment Script"
    13	echo "=================================================================="
    14	
    15	# 1. Update system packages & Install Docker + Certbot
    16	echo "=== [1/5] Updating Packages & Installing System Dependencies ==="
    17	sudo apt-get update -y
    18	sudo apt-get install -y ca-certificates curl gnupg lsb-release certbot
    19	
    20	if ! command -v docker &> /dev/null; then
    21	    echo "Installing Docker Engine..."
    22	    curl -fsSL https://get.docker.com | sh
    23	    sudo usermod -aG docker $USER || true
    24	fi
    25	
    26	# 2. Ensure directory structure exists
    27	echo "=== [2/5] Initializing Directory Structure ==="
    28	mkdir -p tak_data/certs tak_data/data
    29	
    30	# 3. Stop running containers to free Port 80 for Certbot
    31	echo "=== [3/5] Stopping Existing Containers (Freeing Port 80 for SSL) ==="
    32	docker compose -f docker-compose.prod.yml down || true
    33	
    34	# 4. Issue/Renew Let's Encrypt SSL Certificate
    35	echo "=== [4/5] Issuing Let's Encrypt TLS Certificate for $DOMAIN ==="
    36	echo "NOTE: Ensure DNS A-records for $DOMAIN and www.$DOMAIN point to this server."
    37	if [ -d "/etc/letsencrypt/live/$DOMAIN" ]; then
    38	    echo "SSL Certificate already exists. Checking renewal..."
    39	    sudo certbot renew --quiet || true
    40	else
    41	    echo "Requesting new certificate from Let's Encrypt..."
    42	    sudo certbot certonly --standalone \
    43	      -d $DOMAIN -d www.$DOMAIN \
    44	      --non-interactive --agree-tos -m $EMAIL \
    45	      --keep-until-expiring
    46	fi
    47	
    48	# 5. Launch full production stack
    49	echo "=== [5/5] Building & Launching Production Stack ==="
    50	docker compose -f docker-compose.prod.yml up -d --build
    51	
    52	echo "=== Verifying Running Services ==="
    53	docker compose -f docker-compose.prod.yml ps
    54	
    55	echo "=================================================================="
