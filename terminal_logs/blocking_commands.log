        const lon = data.lon;
        const callsign = data.callsign || 'COP-SHAPE';
        const now = new Date();
        const stale = new Date(now.getTime() + 60 * 60 * 1000); // 1 hour stale
        
        let cotType = 'u-d-f'; // Default to freehand/polygon
