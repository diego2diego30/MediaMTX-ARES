# MediaMTX configuration — TAK Server & UAS Integration
# ─────────────────────────────────────────────────────

# RTSP — TCP only (reliable on tactical/mobile links)
rtspTransports: [tcp, udp]
rtsp: yes
rtspAddress: :8554

# RTMP — drone/UAS ingest (DJI Fly, QGC, FFmpeg)
rtmp: yes
rtmpAddress: :1935

# SRT — secure reliable transport (weak/cellular links)
srt: yes
srtAddress: :8890

# HLS — browser and TAK dashboard playback
hls: yes
hlsAddress: :8888
hlsAlwaysRemux: yes
hlsVariant: lowLatency
hlsSegmentDuration: 1s
hlsPartDuration: 200ms
hlsSegmentCount: 7
# Disable the cookie-check redirect — required for browser playback
# from file:// and cross-origin contexts
hlsCDNSecret: ""
hlsAllowOrigins: ["*"]

# WebRTC — sub-second browser playback
webrtc: yes
webrtcAddress: :8889
webrtcAllowOrigins: ["*"]

# Admin API
api: yes
apiAddress: :9997
apiAllowOrigins: ["*"]

# Authentication — open for local development
# Lock down with credentials before cloud deployment
authInternalUsers:
  - user: ares_pilot
    pass: ares_secure
    ips: []
    permissions:
      - action: publish
      - action: read
      - action: api
  - user: any
    pass:
    ips: []
    permissions:
      - action: publish
      - action: read
      - action: api

# Stream paths
paths:
  demo:
    runOnInit: ffmpeg -re -stream_loop -1 -fflags +genpts -i /DayFlight.ts -map 0:v -c:v libx264 -preset ultrafast -tune zerolatency -bf 0 -g 60 -map 0:d? -c:d copy -f mpegts 'srt://127.0.0.1:8890?streamid=publish:demo' -map 0:d? -c:d copy -f rawvideo 'udp://telemetry-bridge:9998'
    runOnInitRestart: yes
  all:
=====COMPOSE PROD
services:
  mediamtx:
    image: bluenviron/mediamtx:latest-ffmpeg
    container_name: mediamtx
    restart: unless-stopped
    ports:
      - "8554:8554"       # RTSP TCP
      - "8554:8554/udp"   # RTSP UDP
      - "8000:8000/udp"   # RTP UDP
      - "8001:8001/udp"   # RTCP UDP
      - "1935:1935"       # RTMP TCP
      - "8888:8888"       # HLS TCP
      - "8889:8889"       # WebRTC TCP
      - "8890:8890/udp"   # SRT UDP
      - "9997:9997"       # Admin API
    volumes:
      - ./mediamtx.yml:/mediamtx.yml:ro
      - ./DayFlight.ts:/DayFlight.ts:ro

  telemetry:
    build:
      context: .
      dockerfile: Dockerfile.telemetry
    container_name: telemetry-bridge
    restart: unless-stopped
    ports:
      - "8081:8081"
      - "9998:9998/udp"   # KLV UDP ingest
      - "4242:4242/udp"   # CoT relay (federation ingest from taknode.com)
    volumes:
      - ./recordings:/app/recordings
      - ./mbtiles:/app/mbtiles
      - ./cert:/app/cert:ro
    environment:
      - MTX_API_URL=http://mediamtx:9997
      - MTX_RTSP_URL=rtsp://mediamtx:8554
      - TAK_SERVER_HOST=host.docker.internal
      - TAK_SERVER_PORT=8089
      - TAK_USE_TLS=true
      - TAK_CLIENT_CERT=/app/cert/admin.pem
