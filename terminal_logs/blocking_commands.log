     1	#!/usr/bin/env bash
     2	# ==============================================================================
     3	# ARES-WERX One-Click Git Sync & Auto-Deploy (Mac -> GitHub -> VPS)
     4	# Pushes local changes to GitHub AND automatically updates the live VPS!
     5	# ==============================================================================
     6	set -e
     7	
     8	VPS_USER="root"
     9	VPS_IP="5.161.45.97"
    10	VPS_DIR="~/MediaMTX-ARES"
    11	COMMIT_MSG="${1:-Update ARES stack & web portal}"
    12	
    13	echo "=================================================================="
    14	echo " 🚀 Syncing ARES-WERX to GitHub & Auto-Deploying to Live VPS"
    15	echo "=================================================================="
    16	
    17	# Ensure Git repository exists
    18	if [ ! -d ".git" ]; then
    19	    echo "Initializing Git repository..."
    20	    git init
    21	    git branch -M main
    22	fi
    23	
    24	# 1. Stage & Commit
    25	echo "=== [1/3] Staging and Committing local changes ==="
    26	git add .
    27	git commit -m "$COMMIT_MSG" || echo "No changes to commit."
    28	
    29	# 2. Push to GitHub
    30	echo "=== [2/3] Pushing to GitHub ==="
    31	git push origin main || git push -u origin main
    32	
    33	# 3. Auto-pull & reload on VPS
    34	echo "=== [3/3] Auto-Deploying to Live VPS ($VPS_IP) ==="
    35	ssh "${VPS_USER}@${VPS_IP}" << EOF
    36	    cd ${VPS_DIR}
    37	    echo "Pulling latest code from GitHub..."
    38	    git pull
    39	    
    40	    echo "Applying docker-compose updates and restarting services..."
    41	    docker compose -f docker-compose.prod.yml up -d --build
    42	    
    43	    echo "Reloading Nginx to refresh single-file bind mounts..."
    44	    docker restart mediamtx-gui
    45	    
    46	    echo "=================================================================="
    47	    echo " 🎉 SUCCESS! Live server updated seamlessly!"
    48	    echo " 🌐 https://ares-werx.com"
    49	    echo "=================================================================="
    50	EOF



