=== docker-compose.yml ===
services:

  mediamtx:
    image: bluenviron/mediamtx:latest-ffmpeg
    container_name: mediamtx
    restart: unless-stopped
    ports:
      - "8554:8554"       # RTSP TCP
      - "8554:8554/udp"   # RTSP UDP
      - "8000:8000/udp"   # RTP UDP
      - "8001:8001/udp"   # RTCP UDP
      - "1935:1935"       # RTMP TCP
      - "8888:8888"       # HLS TCP
      - "8889:8889"       # WebRTC TCP
      - "8890:8890/udp"   # SRT UDP
      - "9997:9997"       # Admin API
    volumes:
      - ./mediamtx.yml:/mediamtx.yml:ro
      - ./DayFlight.ts:/DayFlight.ts:ro

  # Nginx GUI server — serves workspace & proxies API/HLS
  gui:
    image: nginx:alpine
    container_name: mediamtx-gui
    restart: unless-stopped
    ports:
      - "8080:80"
    volumes:
      - ./:/usr/share/nginx/html:ro
      - ./nginx.conf:/etc/nginx/conf.d/default.conf:ro

  # UAS Telemetry Bridge (Node.js + FFmpeg KLV Extraction)
  telemetry:
    build:
      context: .
      dockerfile: Dockerfile.telemetry
    container_name: telemetry-bridge
    restart: unless-stopped
    ports:
      - "8081:8081"
      - "9998:9998/udp"
      - "4242:4242/udp"   # CoT relay (federation ingest)
    environment:
      - MTX_API_URL=http://mediamtx:9997
      - MTX_RTSP_URL=rtsp://mediamtx:8554
      - TAK_SERVER_HOST=host.docker.internal
      - TAK_SERVER_PORT=8089
      - TAK_USE_TLS=true
      - TAK_CLIENT_CERT=/app/cert/admin.pem
      - TAK_CLIENT_KEY=/app/cert/admin.key
      - TAK_CA_CERT=/app/cert/truststore-root.pem
      - TAK_TLS_SERVERNAME=ares-werx.com
    extra_hosts:
      - "host.docker.internal:host-gateway"
    volumes:
      - ./recordings:/app/recordings
      - ./mbtiles:/app/mbtiles
      - ./cert:/app/cert:ro
    depends_on:
      - mediamtx

  # Cloudflare Quick Tunnel — exposes public HTTPS / WebSockets link for MediaMTX GUI
  tunnel:
    image: cloudflare/cloudflared:latest
    container_name: cloudflare-tunnel
    restart: unless-stopped
    command: tunnel --url http://gui:80
    depends_on:
      - gui


=== docker-compose.prod.yml ===
services:
  mediamtx:
    image: bluenviron/mediamtx:latest-ffmpeg
    container_name: mediamtx
    restart: unless-stopped
    ports:
      - "8554:8554"       # RTSP TCP
      - "8554:8554/udp"   # RTSP UDP
      - "8000:8000/udp"   # RTP UDP
      - "8001:8001/udp"   # RTCP UDP
      - "1935:1935"       # RTMP TCP
      - "8888:8888"       # HLS TCP
      - "8889:8889"       # WebRTC TCP
      - "8890:8890/udp"   # SRT UDP
      - "9997:9997"       # Admin API
    volumes:
      - ./mediamtx.yml:/mediamtx.yml:ro
      - ./DayFlight.ts:/DayFlight.ts:ro

  telemetry:
    build:
      context: .
      dockerfile: Dockerfile.telemetry
    container_name: telemetry-bridge
    restart: unless-stopped
    ports:
      - "8081:8081"
      - "9998:9998/udp"   # KLV UDP ingest
      - "4242:4242/udp"   # CoT relay (federation ingest from taknode.com)
    volumes:
      - ./recordings:/app/recordings
      - ./mbtiles:/app/mbtiles
      - ./cert:/app/cert:ro
    environment:
      - MTX_API_URL=http://mediamtx:9997
      - MTX_RTSP_URL=rtsp://mediamtx:8554
      - TAK_SERVER_HOST=host.docker.internal
      - TAK_SERVER_PORT=8089
      - TAK_USE_TLS=true
      - TAK_CLIENT_CERT=/app/cert/admin.pem
      - TAK_CLIENT_KEY=/app/cert/admin.key
      - TAK_CA_CERT=/app/cert/truststore-root.pem
      - TAK_TLS_SERVERNAME=ares-werx.com
    extra_hosts:
      - "host.docker.internal:host-gateway"
    depends_on:
      - mediamtx

  gui:
    image: nginx:alpine
    container_name: mediamtx-gui
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
      - "8444:8444"
    volumes:
      - ./:/usr/share/nginx/html:ro
      - ./nginx.prod.conf:/etc/nginx/conf.d/default.conf:ro
      - /etc/letsencrypt:/etc/letsencrypt:ro
      - ./cert:/etc/nginx/tak-cert:ro
    extra_hosts:
      - "host.docker.internal:host-gateway"
    depends_on:
      - mediamtx
      - telemetry
    networks:
      - default
      - takserver_default

  # Optional TAK Server Container
  # Official TAK Server images are distributed via TAK.gov (not Docker Hub).
  # Load your official TAK Docker release tarball via `docker load -i takserver.tar` before enabling.
  # tak-server:
  #   image: takserver/takserver:latest
  #   container_name: tak-server
  #   restart: unless-stopped
  #   ports:
  #     - "8087:8087"       # Plain CoT TCP
  #     - "8089:8089"       # TLS CoT (ATAK/WinTAK)
  #     - "8443:8443"       # TAK Web Admin UI
  #   environment:
  #     - STATE=production
  #   volumes:
  #     - ./tak_data/certs:/opt/tak/certs
  #     - ./tak_data/data:/opt/tak/data

networks:
  takserver_default:
    external: true

=== Dockerfile ===
# syntax=docker/dockerfile:1

# ---------- Build Stage ----------
FROM golang:1.22-alpine AS builder
WORKDIR /app

# Install git and ca-certificates
RUN apk add --no-cache git ca-certificates

# Clone the MediaMTX-ARES repository (replace <REPO_URL> with actual URL)
ARG REPO_URL="<REPO_URL>"
RUN git clone $REPO_URL .

# Build the MediaMTX binary (assumes a Makefile or go build script)
RUN go build -v -o mediamtx ./cmd/mediamtx

# ---------- Runtime Stage ----------
FROM alpine:latest
RUN apk add --no-cache ca-certificates ffmpeg
WORKDIR /app

# Copy built binary
COPY --from=builder /app/mediamtx /usr/local/bin/mediamtx

# Expose streaming ports (RTMP, HLS, etc.)
EXPOSE 1935 8080

# Default command to run MediaMTX
ENTRYPOINT ["mediamtx", "-config", "/app/config.yml"]
=== Dockerfile.telemetry ===
FROM node:22-alpine

# Install FFmpeg for stream extraction
RUN apk add --no-cache ffmpeg

WORKDIR /app

# Copy package files and install dependencies
COPY package*.json ./
RUN npm install --production

# Copy the bridge application
COPY telemetry_bridge.js .

# Copy certificates for TAK TLS connections
COPY cert/ /app/cert/

# Expose the WebSocket port
EXPOSE 8081

# Run the bridge
CMD ["node", "telemetry_bridge.js"]
