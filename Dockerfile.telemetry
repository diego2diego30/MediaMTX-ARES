FROM node:22-alpine

# Install FFmpeg for stream extraction + docker-cli for cert generation + openssl for fingerprint extraction
RUN apk add --no-cache ffmpeg docker-cli openssl

WORKDIR /app

# Copy package files and install dependencies
COPY package*.json ./
RUN npm install --production

# Copy the bridge application
COPY telemetry_bridge.js .

# Copy certificates for TAK TLS connections
COPY cert/ /app/cert/

# Expose the WebSocket port
EXPOSE 8081

# Run the bridge
CMD ["node", "telemetry_bridge.js"]
