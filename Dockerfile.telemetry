FROM node:22-alpine

# ffmpeg: stream extraction. docker-cli: cert generation (docker exec/cp into takserver).
# openssl: fingerprint extraction + p12 re-encryption. bash + zip: required by
# bin/generate-user-zip.sh, which the bridge now shells out to (see D11/D7 — it
# used to duplicate this logic inline in JS with no bash/zip dependency at all).
RUN apk add --no-cache ffmpeg docker-cli openssl bash zip

WORKDIR /app

# Copy package files and install dependencies
COPY package*.json ./
RUN npm install --production

# Copy the bridge application
COPY telemetry_bridge.js .
COPY lib/ /app/lib/
COPY bin/ /app/bin/

# Copy certificates for TAK TLS connections
COPY cert/ /app/cert/

# Expose the WebSocket port
EXPOSE 8081

# Run the bridge
CMD ["node", "telemetry_bridge.js"]
